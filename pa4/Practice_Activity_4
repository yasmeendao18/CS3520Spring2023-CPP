// function to calculate rows in 2D vector
int calcNumRows(const int count){
  int numRows = 1;
  for(int i = 2; i < count/2; i++){
    if(count%i == 0){
      numRows = i;
    }
  }
  if(numRows == 1) {
    numRows = 2;
  }
  return numRows;
}

